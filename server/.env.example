# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.uieadob.mongodb.net/?retryWrites=true&w=majority

# Enable in-memory MongoDB fallback when Atlas network access is blocked
ALLOW_LOCAL_FALLBACK=true

# Allowed Frontend Client URL (for CORS and CSRF origin verification)
CLIENT_URL=http://localhost:5173

# JWT Secret for Session Cookies (Change to a cryptographically secure random string in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# JWT Expiration Period
JWT_EXPIRES_IN=7d

# Google OAuth2 Client ID (From Google Cloud Console)
# Optional: Required only for Google Sign-In verification
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
